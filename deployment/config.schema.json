{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stronk-dev/destroy-humanity-any-percent/deployment/config.schema.json",
  "title": "Cloud Clicker Phase-0 operator environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "CLOUD_CLICKER_PUBLIC_ORIGIN",
    "CLOUD_CLICKER_SERVER_ID",
    "CLOUD_CLICKER_JWT_CURRENT_ID",
    "CLOUD_CLICKER_BOOTSTRAP_CURRENT_ID",
    "CLOUD_CLICKER_DATABASE_URL_SECRET_FILE",
    "CLOUD_CLICKER_POSTGRES_PASSWORD_SECRET_FILE",
    "CLOUD_CLICKER_JWT_CURRENT_SECRET_FILE",
    "CLOUD_CLICKER_BOOTSTRAP_CURRENT_SECRET_FILE"
  ],
  "properties": {
    "CLOUD_CLICKER_PUBLIC_ORIGIN": { "type": "string", "pattern": "^https://[^/?#]+$" },
    "CLOUD_CLICKER_SERVER_ID": { "type": "string", "format": "uuid" },
    "CLOUD_CLICKER_JWT_CURRENT_ID": { "$ref": "#/$defs/keyID" },
    "CLOUD_CLICKER_BOOTSTRAP_CURRENT_ID": { "$ref": "#/$defs/keyID" },
    "POSTGRES_DB": { "$ref": "#/$defs/databaseName" },
    "POSTGRES_USER": { "$ref": "#/$defs/databaseName" },
    "CLOUD_CLICKER_DATABASE_URL_SECRET_FILE": { "$ref": "#/$defs/secretPath" },
    "CLOUD_CLICKER_POSTGRES_PASSWORD_SECRET_FILE": { "$ref": "#/$defs/secretPath" },
    "CLOUD_CLICKER_JWT_CURRENT_SECRET_FILE": { "$ref": "#/$defs/secretPath" },
    "CLOUD_CLICKER_BOOTSTRAP_CURRENT_SECRET_FILE": { "$ref": "#/$defs/secretPath" },
    "CLOUD_CLICKER_HTTP_PORT": { "$ref": "#/$defs/port" },
    "CLOUD_CLICKER_HTTPS_PORT": { "$ref": "#/$defs/port" }
  },
  "$defs": {
    "keyID": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "databaseName": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
    "secretPath": { "type": "string", "minLength": 1 },
    "port": { "type": "string", "pattern": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$" }
  }
}
