# Non-secret operator configuration. Secret values live in the files named below.
CLOUD_CLICKER_PUBLIC_ORIGIN=https://play.example.com
CLOUD_CLICKER_SERVER_ID=01986666-b001-4000-8000-000000000001
CLOUD_CLICKER_JWT_CURRENT_ID=jwt-2026-08
CLOUD_CLICKER_BOOTSTRAP_CURRENT_ID=bootstrap-2026-08
POSTGRES_DB=cloud_clicker
POSTGRES_USER=cloud_clicker
CLOUD_CLICKER_BACKUP_TARGET=/mnt/cloud-clicker-backups
CLOUD_CLICKER_AGE_RECIPIENT=age1example_replace_with_operator_x25519_recipient

# Host paths to operator-owned secret files. Do not put their contents in this file.
CLOUD_CLICKER_DATABASE_URL_SECRET_FILE=./secrets/database-url
CLOUD_CLICKER_POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres-password
CLOUD_CLICKER_JWT_CURRENT_SECRET_FILE=./secrets/jwt-current
CLOUD_CLICKER_BOOTSTRAP_CURRENT_SECRET_FILE=./secrets/bootstrap-current

# Optional host-port overrides. Only Caddy publishes them.
CLOUD_CLICKER_HTTP_PORT=80
CLOUD_CLICKER_HTTPS_PORT=443
