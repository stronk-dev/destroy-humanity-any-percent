{
	admin off
	metrics
}

# Private scrape listener. The management API is disabled above so
# no peer on a shared network can read or replace the live configuration.
:2020 {
	metrics
}

{$CLOUD_CLICKER_PUBLIC_ORIGIN} {
	encode zstd gzip

	@api path /api/* /connection/websocket /healthz /readyz
	handle @api {
		reverse_proxy gameserver:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		# Cosmetic Shop v1 N6: no Payment Request API, and the page may only
		# connect to its own origin and the same-host gameserver WebSocket.
		Permissions-Policy "payment=()"
		Content-Security-Policy "connect-src 'self' wss://{host}"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}
