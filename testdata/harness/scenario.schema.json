{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-clicker.invalid/harness-scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "catalog", "commons_catalog", "runs", "milestones", "envelopes", "required_invariants"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "version": {"type": "integer", "minimum": 1},
    "catalog": {"type": "string", "pattern": "^balance/catalogs/[a-z0-9_-]+\\.json$"},
    "commons_catalog": {"type": "string", "pattern": "^balance/commons/[a-z0-9_-]+\\.json$"},
    "runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/run"}},
    "milestones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/milestone"}},
    "envelopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/envelope"}},
    "required_invariants": {"type": "array", "uniqueItems": true, "items": {"enum": ["state_encodes", "numeric_domain", "resource_bounds", "ledger_reconciles", "revision_monotone", "must_reach"]}}
  },
  "$defs": {
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_version", "seed_start", "seed_count", "horizon_ms"],
      "properties": {
        "policy_id": {"enum": ["casual.phase0", "chaos.phase0"]},
        "policy_version": {"const": 1},
        "seed_start": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "seed_count": {"type": "integer", "minimum": 1},
        "horizon_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "milestone": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "must_reach"],
      "properties": {
        "id": {"type": "string"}, "kind": {"enum": ["intent_applied", "event_seen", "resource_at_least", "generator_count_at_least", "progress_at_least"]},
        "must_reach": {"type": "boolean"}, "intent_kind": {"type": "string"}, "event_kind": {"type": "string"},
        "resource_id": {"type": "string"}, "amount": {"type": "string"}, "generator_id": {"type": "string"},
        "count": {"type": "integer", "minimum": 1}, "tier": {"type": "integer", "minimum": 0}
      }
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "milestone_id", "statistic"],
      "properties": {
        "policy_id": {"type": "string"}, "milestone_id": {"type": "string"},
        "statistic": {"enum": ["best", "p05", "p50", "p95", "worst"]},
        "minimum_ms": {"type": "integer", "minimum": 0}, "maximum_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
