 	return { pressed };
 }
 function focusIframe() {
-	if (!document.activeElement || document.activeElement.ownerDocument !== document || document.activeElement === document.body) {
+	if (!document.hasFocus() || !document.activeElement || document.activeElement.ownerDocument !== document || document.activeElement === document.body) {
