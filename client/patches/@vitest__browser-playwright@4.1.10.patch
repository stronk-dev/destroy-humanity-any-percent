+				project.browser.registerCommand(name, (...args) => {
+					const result = nativeInput.then(() => command(...args));
+					nativeInput = result.then(() => undefined, () => undefined);
+					return result;
+				});
+			} else {
+				project.browser.registerCommand(name, command);
+			}
