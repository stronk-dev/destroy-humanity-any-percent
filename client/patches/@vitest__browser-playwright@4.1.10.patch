+		// Firefox native activation shares focus across contexts. Keep frame focus
+		// and native delivery indivisible with respect to other input commands.
+		// Files and non-input commands remain parallel; rejected work releases FIFO.
+		const nativeCommands = new Set(["__vitest_upload", "__vitest_click", "__vitest_dblClick",
+			"__vitest_tripleClick", "__vitest_wheel", "__vitest_type", "__vitest_clear",
