+func TestSparseAggregationResearchEqualExponentRuns(t *testing.T) {
+	positive := make([]Decimal, 65_537)
+	for index := range positive {
+		positive[index] = New(3.003003003, 0)
+	}
+	// Independent exact rational for the repeated represented value. Its
+	// magnitude is between1e5 and1e6, so normalize once before binary rounding.
+	reference := new(big.Rat).SetFloat64(positive[0].mantissa)
+	reference.Mul(reference, big.NewRat(int64(len(positive)), 100_000))
+	wantMantissa, _ := reference.Float64()
+	got, work, err := sparseSumResearch(positive)
+	if err != nil || !got.Eq(New(wantMantissa, 5)) || work.chunks > 3 {
+		t.Fatal("long positive run differs from exact rational/work bound", got, work, err)
+	}
+	for _, exponent := range []int64{-maxExponent, -32, 0, 32, maxExponent} {
+		values := make([]Decimal, 65_537)
+		for index := range values {
+			values[index] = New(3.003003003, exponent)
+		}
+		// A complete signed cancellation inside a run must retain the final
+		// literal value even at both full-domain exponent endpoints.
+		for index := 0; index < len(values)-1; index += 2 {
+			values[index+1] = values[index].Neg()
+		}
+		got, work, err := sparseSumResearch(values)
+		want := values[len(values)-1]
+		if err != nil || !got.Eq(want) || work.chunks > 3 {
+			t.Fatal("long exact cancellation/run work differs", exponent, got, want, work, err)
+		}
+		values[len(values)-1] = NaN
+		got, _, err = sparseSumResearch(values)
+		if err != nil || !got.IsNaN() {
+			t.Fatal("completed cancellation hides invalid tail", exponent, got, err)
+		}
+	}
+	for _, exponent := range []int64{-32, 0, 32} {
+		values := []Decimal{New(1, exponent), New(math.Nextafter(1, 2), exponent), New(-1, exponent), New(4, exponent)}
+		want := sparseRationalOracleResearch(t, values)
+		got, _, err := sparseSumResearch(values)
+		if err != nil || !got.Eq(want) {
+			t.Fatal("same-exponent round/tie differs from rational", exponent, got, want, err)
+		}
+	}
+}
