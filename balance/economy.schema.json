{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destroy-humanity-any-percent.invalid/schema/economy-v4.json",
  "title": "Cloud Clicker economy catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resources",
    "generator_classes",
    "manual_actions",
    "multiplier_sources",
    "progress_coordinates",
    "manual_policy",
    "offline_policy"
  ],
  "properties": {
    "schema_version": { "enum": [3, 4] },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "generator_classes": { "type": "array", "items": { "$ref": "#/$defs/generator_class" } },
    "manual_actions": { "type": "array", "items": { "$ref": "#/$defs/manual_action" } },
    "multiplier_sources": { "type": "array", "items": { "$ref": "#/$defs/multiplier_source" } },
    "progress_coordinates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/progress_coordinate" }
    },
    "manual_policy": { "$ref": "#/$defs/manual_policy" },
    "offline_policy": { "$ref": "#/$defs/offline_policy" },
    "upgrades": { "type": "array", "items": { "$ref": "#/$defs/upgrade" } },
    "synergy_pools": { "type": "array", "items": { "$ref": "#/$defs/synergy_pool" } },
    "provision_tick_ms": { "$ref": "#/$defs/positive_safe_integer" }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 4 } }, "required": ["schema_version"] },
      "then": {
        "required": ["upgrades", "synergy_pools", "provision_tick_ms"],
        "properties": {
          "upgrades": {},
          "synergy_pools": {},
          "provision_tick_ms": {},
          "generator_classes": {
            "type": "array",
            "items": { "allOf": [{ "$ref": "#/$defs/generator_class" }, { "type": "object", "required": ["tier", "category", "ladder", "roles"], "properties": { "tier": {}, "category": {}, "ladder": {}, "roles": {} } }] }
          }
        }
      },
      "else": {
        "properties": {
          "upgrades": false,
          "synergy_pools": false,
          "provision_tick_ms": false,
          "generator_classes": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/$defs/generator_class" },
                { "type": "object", "properties": { "tier": false, "category": false, "provisions": false, "provisioned_hardcap": false, "ladder": false, "roles": false } }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|-?[1-9](?:\\.\\d{0,10}[1-9])?e(?:0|-?[1-9]\\d*))$"
    },
    "positive_decimal": {
      "type": "string",
      "pattern": "^[1-9](?:\\.\\d{0,10}[1-9])?e(?:0|-?[1-9]\\d*)$"
    },
    "positive_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "hardcap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "reason_key"],
      "properties": {
        "amount": { "$ref": "#/$defs/decimal" },
        "reason_key": { "$ref": "#/$defs/id" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "numeric_kind", "initial", "minimum", "hardcap"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": { "enum": ["company", "founder", "world", "guild"] },
        "numeric_kind": { "const": "decimal" },
        "initial": { "$ref": "#/$defs/decimal" },
        "minimum": { "$ref": "#/$defs/decimal" },
        "hardcap": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hardcap" }] }
      }
    },
    "constant_curve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "constant" } }
    },
    "linear_curve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "step"],
      "properties": {
        "kind": { "const": "linear" },
        "step": { "$ref": "#/$defs/decimal" }
      }
    },
    "geometric_curve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ratio"],
      "properties": {
        "kind": { "const": "geometric" },
        "ratio": { "$ref": "#/$defs/decimal" }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "base", "curve"],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "base": { "$ref": "#/$defs/positive_decimal" },
        "curve": {
          "oneOf": [
            { "$ref": "#/$defs/constant_curve" },
            { "$ref": "#/$defs/linear_curve" },
            { "$ref": "#/$defs/geometric_curve" }
          ]
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "base_rate"],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "base_rate": { "$ref": "#/$defs/positive_decimal" }
      }
    },
    "generator_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "price", "production"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
        "category": { "$ref": "#/$defs/id" },
        "price": { "$ref": "#/$defs/price" },
        "production": { "$ref": "#/$defs/production" },
        "provisions": { "$ref": "#/$defs/provision" },
        "provisioned_hardcap": { "$ref": "#/$defs/provisioned_hardcap" },
        "ladder": { "type": "array", "items": { "$ref": "#/$defs/ladder_rung" } },
        "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/generator_role" } }
      }
    },
    "provision": {
      "type": "object", "additionalProperties": false, "required": ["generator_id", "rate_ppm"],
      "properties": { "generator_id": { "$ref": "#/$defs/id" }, "rate_ppm": { "$ref": "#/$defs/positive_safe_integer" } }
    },
    "provisioned_hardcap": {
      "type": "object", "additionalProperties": false, "required": ["count", "reason_key"],
      "properties": { "count": { "$ref": "#/$defs/positive_safe_integer" }, "reason_key": { "$ref": "#/$defs/id" } }
    },
    "ladder_rung": {
      "type": "object", "additionalProperties": false, "required": ["purchased_at", "multiplier_ppm"],
      "properties": { "purchased_at": { "$ref": "#/$defs/positive_safe_integer" }, "multiplier_ppm": { "$ref": "#/$defs/positive_safe_integer" } }
    },
    "generator_role": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "generator_id"], "properties": { "kind": { "const": "provision" }, "generator_id": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "pool_id"], "properties": { "kind": { "const": "synergy_feed" }, "pool_id": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "action_id", "per_purchased_ppm"], "properties": { "kind": { "const": "manual_output" }, "action_id": { "$ref": "#/$defs/id" }, "per_purchased_ppm": { "$ref": "#/$defs/positive_safe_integer" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "per_purchased_ppm"], "properties": { "kind": { "const": "stock_rate" }, "per_purchased_ppm": { "$ref": "#/$defs/positive_safe_integer" } } }
      ]
    },
    "upgrade": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "cost", "window", "requires", "effects", "roles", "copy_key"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "cost": { "type": "object", "additionalProperties": false, "required": ["resource", "amount"], "properties": { "resource": { "$ref": "#/$defs/id" }, "amount": { "$ref": "#/$defs/positive_decimal" } } },
        "window": { "type": "object", "additionalProperties": false, "required": ["from_gate", "to_gate"], "properties": { "from_gate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }, "to_gate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] } } },
        "requires": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/upgrade_effect" } },
        "roles": { "type": "array", "items": { "enum": ["provision", "synergy_feed", "manual_output", "stock_rate"] } },
        "copy_key": { "$ref": "#/$defs/id" }
      }
    },
    "upgrade_effect": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "slot", "target", "factor"],
      "properties": { "source_id": { "$ref": "#/$defs/id" }, "slot": { "const": "upgrades" }, "target": { "$ref": "#/$defs/id" }, "factor": { "$ref": "#/$defs/positive_decimal" } }
    },
    "synergy_pool": {
      "type": "object", "additionalProperties": false, "required": ["id", "sources", "slot", "curve"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/synergy_source" } },
        "slot": { "enum": ["upgrades", "milestones", "faction", "doctrine", "commons", "trust", "event_buffs", "prestige"] },
        "curve": { "enum": ["linear", "log"] }
      }
    },
    "synergy_source": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id_or_class", "per_count_ppm"],
      "properties": { "kind": { "enum": ["generator", "upgrade"] }, "id_or_class": { "$ref": "#/$defs/id" }, "per_count_ppm": { "$ref": "#/$defs/positive_safe_integer" } }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/resource_condition" },
        { "$ref": "#/$defs/meter_condition" },
        { "$ref": "#/$defs/doctrine_condition" },
        { "$ref": "#/$defs/structure_condition" },
        { "$ref": "#/$defs/fact_condition" },
        { "$ref": "#/$defs/trait_condition" }
      ]
    },
    "resource_condition": {
      "type": "object", "additionalProperties": false, "required": ["kind", "resource_id", "value"],
      "properties": { "kind": { "enum": ["resource_at_least", "resource_at_most"] }, "resource_id": { "$ref": "#/$defs/id" }, "value": { "$ref": "#/$defs/decimal" } }
    },
    "meter_condition": {
      "type": "object", "additionalProperties": false, "required": ["kind", "meter_id", "min", "max"],
      "properties": { "kind": { "const": "meter_band" }, "meter_id": { "$ref": "#/$defs/id" }, "min": { "type": "integer", "minimum": 0, "maximum": 100 }, "max": { "type": "integer", "minimum": 0, "maximum": 100 } }
    },
    "doctrine_condition": {
      "type": "object", "additionalProperties": false, "required": ["kind", "transition", "doctrine_id"],
      "properties": { "kind": { "enum": ["doctrine_is", "doctrine_is_not"] }, "transition": { "$ref": "#/$defs/id" }, "doctrine_id": { "$ref": "#/$defs/id" } }
    },
    "structure_condition": {
      "type": "object", "additionalProperties": false, "required": ["kind", "structure_id"],
      "properties": { "kind": { "const": "structure_is" }, "structure_id": { "$ref": "#/$defs/id" } }
    },
    "fact_condition": {
      "type": "object", "additionalProperties": false, "required": ["kind", "fact_kind"],
      "properties": { "kind": { "const": "ledger_fact_present" }, "fact_kind": { "$ref": "#/$defs/id" } }
    },
    "trait_condition": {
      "type": "object", "additionalProperties": false, "required": ["kind", "trait_id"],
      "properties": { "kind": { "const": "region_trait" }, "trait_id": { "$ref": "#/$defs/id" } }
    },
    "manual_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "output"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_id", "amount_per_action"],
          "properties": {
            "resource_id": { "$ref": "#/$defs/id" },
            "amount_per_action": { "$ref": "#/$defs/positive_decimal" }
          }
        }
      }
    },
    "multiplier_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slot", "target", "provider"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slot": {
          "enum": ["upgrades", "milestones", "faction", "doctrine", "commons", "trust", "event_buffs", "prestige"]
        },
        "target": { "anyOf": [{ "const": "all" }, { "$ref": "#/$defs/id" }] },
        "provider": { "$ref": "#/$defs/id" }
      }
    },
    "resource_log_term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "kind", "resource", "target"],
      "properties": {
        "weight": { "$ref": "#/$defs/positive_decimal" },
        "kind": { "const": "resource_log" },
        "resource": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/positive_decimal" }
      }
    },
    "count_fraction_term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "kind", "count", "required"],
      "properties": {
        "weight": { "$ref": "#/$defs/positive_decimal" },
        "kind": { "const": "count_fraction" },
        "count": { "const": "generators.total_owned" },
        "required": { "$ref": "#/$defs/positive_safe_integer" }
      }
    },
    "progress_coordinate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "kind", "resource", "target"],
          "properties": {
            "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
            "kind": { "const": "resource_log" },
            "resource": { "$ref": "#/$defs/id" },
            "target": { "$ref": "#/$defs/positive_decimal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "kind", "count", "required"],
          "properties": {
            "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
            "kind": { "const": "count_fraction" },
            "count": { "const": "generators.total_owned" },
            "required": { "$ref": "#/$defs/positive_safe_integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "kind", "terms"],
          "properties": {
            "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
            "kind": { "const": "composite" },
            "terms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/resource_log_term" },
                  { "$ref": "#/$defs/count_fraction_term" }
                ]
              }
            }
          }
        }
      ]
    },
    "manual_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refill_milli_per_ms", "bucket_cap_milli"],
      "properties": {
        "refill_milli_per_ms": { "$ref": "#/$defs/positive_safe_integer" },
        "bucket_cap_milli": { "$ref": "#/$defs/positive_safe_integer" }
      }
    },
    "offline_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "efficiency",
        "accrual_cap_ms",
        "bank_ratio_numerator",
        "bank_ratio_denominator",
        "bank_cap_ms",
        "burst_speed",
        "burst_max_duration_ms"
      ],
      "properties": {
        "efficiency": { "$ref": "#/$defs/decimal" },
        "accrual_cap_ms": { "$ref": "#/$defs/positive_safe_integer" },
        "bank_ratio_numerator": { "$ref": "#/$defs/positive_safe_integer" },
        "bank_ratio_denominator": { "$ref": "#/$defs/positive_safe_integer" },
        "bank_cap_ms": { "$ref": "#/$defs/positive_safe_integer" },
        "burst_speed": { "$ref": "#/$defs/positive_decimal" },
        "burst_max_duration_ms": { "$ref": "#/$defs/positive_safe_integer" }
      }
    }
  }
}
