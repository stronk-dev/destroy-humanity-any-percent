{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloud Clicker doctrine-choice catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transitions"],
  "properties": {
    "schema_version": { "const": 1 },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "source_tier", "gate_id", "doctrine_ids"],
      "properties": {
        "transition_id": { "type": "string", "pattern": "^transition\\.t[0-8]_to_t[1-9]$" },
        "source_tier": { "type": "integer", "minimum": 0, "maximum": 8 },
        "gate_id": { "type": "string", "pattern": "^gate\\.t[0-8]_to_t[1-9]$" },
        "doctrine_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
