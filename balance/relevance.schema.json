{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-clicker.invalid/relevance-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items", "groups"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 1 } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "availability_window": {
                  "type": "object",
                  "properties": { "from_gate": { "$ref": "#/$defs/id" } }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "safePositive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["from_gate", "to_gate"],
      "properties": { "from_gate": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "to_gate": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] } }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["purchasable_id", "availability_window", "epsilon_ms", "trap_exempt", "justification_key", "group_ids"],
      "properties": {
        "purchasable_id": { "$ref": "#/$defs/id" }, "availability_window": { "$ref": "#/$defs/window" },
        "epsilon_ms": { "$ref": "#/$defs/safePositive" }, "trap_exempt": { "type": "boolean" },
        "justification_key": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "group_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["group_id", "axis", "member_ids", "epsilon_ms"],
      "properties": {
        "group_id": { "$ref": "#/$defs/id" }, "axis": { "enum": ["tier", "category", "declared"] },
        "member_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "epsilon_ms": { "$ref": "#/$defs/safePositive" }
      }
    }
  }
}
