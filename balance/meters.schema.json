{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloud Clicker meter catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trust_reseed", "meters"],
  "properties": {
    "schema_version": { "const": 1 },
    "trust_reseed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_value", "notoriety_numerator", "notoriety_denominator", "floor_value", "ceiling_value"],
      "properties": {
        "base_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "notoriety_numerator": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "notoriety_denominator": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "floor_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "ceiling_value": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "meters": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/meter" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "floor_value"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "floor_value": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "ledger_fact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fact_kind", "delta"],
      "properties": {
        "kind": { "const": "ledger_fact" },
        "fact_kind": { "$ref": "#/$defs/id" },
        "delta": { "type": "integer", "minimum": -100, "maximum": 100, "not": { "const": 0 } }
      }
    },
    "contribution_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slot", "source_id", "delta_per_attended_hour"],
      "properties": {
        "kind": { "const": "contribution_slot" },
        "slot": { "enum": ["upgrades", "milestones", "faction", "doctrine", "commons", "trust", "event_buffs", "prestige"] },
        "source_id": { "$ref": "#/$defs/id" },
        "delta_per_attended_hour": { "type": "integer", "minimum": -100, "maximum": 100, "not": { "const": 0 } }
      }
    },
    "decay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toward_value", "rate_per_attended_hour"],
      "properties": {
        "toward_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "rate_per_attended_hour": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "min_value", "max_value", "initial_value", "bands", "inputs", "decay"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": { "const": "company" },
        "min_value": { "const": 0 },
        "max_value": { "const": 100 },
        "initial_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "bands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/band" } },
        "inputs": {
          "type": "array",
          "items": { "oneOf": [{ "$ref": "#/$defs/ledger_fact_input" }, { "$ref": "#/$defs/contribution_input" }] }
        },
        "decay": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/decay" }] }
      }
    }
  }
}
