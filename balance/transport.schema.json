{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "world_hz", "feed_history_size", "player_history_size", "player_history_ttl_ms", "player_queue_messages", "player_queue_bytes", "message_bytes", "subscriptions_per_connection", "connections_per_account", "drain_timeout_ms", "allowed_origins"],
  "properties": {
    "schema_version": {"const": 1},
    "world_hz": {"type": "integer", "minimum": 4, "maximum": 10},
    "feed_history_size": {"type": "integer", "minimum": 1, "maximum": 512},
    "player_history_size": {"type": "integer", "minimum": 256, "maximum": 4096},
    "player_history_ttl_ms": {"type": "integer", "minimum": 60000, "maximum": 3600000},
    "player_queue_messages": {"type": "integer", "minimum": 64, "maximum": 4096},
    "player_queue_bytes": {"type": "integer", "minimum": 65536, "maximum": 16777216},
    "message_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
    "subscriptions_per_connection": {"type": "integer", "minimum": 1, "maximum": 64},
    "connections_per_account": {"type": "integer", "minimum": 1, "maximum": 10},
    "drain_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 60000},
    "allowed_origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^https?://[^/]+$"}}
  }
}
