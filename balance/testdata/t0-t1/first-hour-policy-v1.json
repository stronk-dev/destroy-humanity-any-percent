  "exit_rules": [
    {
      "id": "t01_c32_readiness",
      "all": [
        { "kind": "run_seq_at_least", "run_seq": 2 },
        { "kind": "gate_crossed", "gate_id": "gate.t0_to_t1" },
        { "kind": "founder_attended_ms_at_least", "attended_ms": 2700000 },
        { "kind": "previewed_exit_grants_any_persistent_value" }
