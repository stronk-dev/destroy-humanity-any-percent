      "model": "first-session enthusiast: one unbroken sitting, frequent uninformed actions",
      "sessions": [{ "start_ms": 0, "duration_ms": 7200000, "repeat_every_ms": 0 }],
      "session_start_jitter_ms": 0,
      "action_cadence_ms": 2000,
      "decision": {
        "kind": "seeded_uniform_over_legal",
        "legal_commands": ["perform_manual_batch", "buy_generator", "buy_upgrade", "wait"],
        "manual_batch_count": 1,
        "affordability": "current_balance_only",
        "wait_advances_to": "next_action_boundary"
      },
      "gate_crossing": "first_boundary_requirements_met",
      "run_continuation": "same_policy_new_run",
      "exit_rule": "t01_c32_readiness"
    },
    {
      "policy_id": "casual.t0_t1",
      "policy_version": 1,
      "model": "returns between other things: fixed windows, unhurried, buys what is cheap",
      "sessions": [{ "start_ms": 0, "duration_ms": 900000, "repeat_every_ms": 1800000 }],
      "session_start_jitter_ms": 300000,
      "action_cadence_ms": 5000,
      "decision": {
        "kind": "cheapest_affordable_then_manual",
        "legal_commands": ["perform_manual_batch", "buy_generator", "buy_upgrade", "wait"],
        "manual_batch_count": 1,
        "affordability": "current_balance_only",
        "wait_advances_to": "next_action_boundary"
      },
      "gate_crossing": "first_boundary_requirements_met",
      "run_continuation": "same_policy_new_run",
      "exit_rule": "t01_c32_readiness"
    },
    {
      "policy_id": "reference.greedy",
      "policy_version": 1,
      "model": "optimal-play upper bound: the shipped projected-time ranker, no second economy model",
      "sessions": [{ "start_ms": 0, "duration_ms": 7200000, "repeat_every_ms": 0 }],
      "session_start_jitter_ms": 0,
      "action_cadence_ms": 1000,
      "decision": {
        "kind": "t01_c20_projected_time_ranker",
